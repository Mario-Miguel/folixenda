# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# HTTP port of the API (default 8080)
PORT=8080

# Postgres (all required)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=folixenda

# Better Auth JWT verification
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=http://localhost:3000

# Event images. STORAGE_DRIVER=local (default) keeps them on disk under
# LOCAL_STORAGE_DIR and serves them from this API at /uploads; the public base
# URL defaults to http://localhost:PORT/uploads.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=uploads
LOCAL_STORAGE_PUBLIC_URL=http://localhost:8080/uploads

# STORAGE_DRIVER=s3: any S3-compatible service (AWS S3, Cloudflare R2, MinIO...).
# S3_ENDPOINT is host[:port] without scheme. S3_PUBLIC_URL is the base URL that
# browsers use for <img src> (object keys are appended to it); when empty it
# defaults to http(s)://S3_ENDPOINT/S3_BUCKET.
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_BUCKET=folixenda-events
S3_USE_SSL=false
S3_REGION=
S3_PUBLIC_URL=http://localhost:9000/folixenda-events
# true = don't create the bucket / set its public-read policy on startup (for
# providers like R2 where that is configured outside the API).
S3_SKIP_BUCKET_SETUP=false
